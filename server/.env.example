# ---------- Core ----------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/e_invite
JWT_SECRET=

# ---------- URLs ----------
# Development:
# CLIENT_URL=http://localhost:5173
# ADMIN_URL=http://localhost:8080
# SERVER_URL=http://localhost:5000
#
# Production:
# CLIENT_URL=https://amulet.am
# ADMIN_URL=https://admin.amulet.am
# SERVER_URL=https://server.amulet.am

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:8080
SERVER_URL=http://localhost:5000

# Additional allowed CORS origins, comma-separated
CORS_EXTRA_ORIGINS=http://localhost:5173

# ---------- Local media storage ----------
# Production files live outside the Git checkout and are served by Nginx
MEDIA_ROOT=/var/lib/amulet/media
MEDIA_PUBLIC_URL=https://server.amulet.am/media

# ---------- Auth cookie ----------
AUTH_COOKIE_NAME=amulet_auth
AUTH_COOKIE_MAX_AGE_MS=604800000

# Development: leave blank
# Production: .amulet.am
AUTH_COOKIE_DOMAIN=

# ---------- Google ----------
GOOGLE_CLIENT_ID=

# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
AMULET_EMAIL_FROM="Amulet <example@gmail.com>"

# ==============================
# Payment provider
# ==============================
PAYMENT_PROVIDER=arca

# ==============================
# ArCa / AraratBank
# ==============================
ARCA_API_BASE_URL=https://epg.arca.am/payment/rest
ARCA_USERNAME=
ARCA_PASSWORD=

# ISO 4217 numeric currency code
# AMD = 051
ARCA_CURRENCY=051

ARCA_LANGUAGE=hy
ARCA_PAYMENT_DESCRIPTION=Amulet online invitation payment
ARCA_REQUEST_TIMEOUT_MS=15000

# Payment status endpoint
ARCA_STATUS_ENDPOINT=getOrderStatusExtended.do

# Optional merchant configuration
ARCA_CLIENT_ID=
ARCA_MERCHANT_ID=
ARCA_TERMINAL_ID=

# ArCa amount multiplier
ARCA_AMOUNT_MULTIPLIER=100

# Development:
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:5000
#
# Production:
# FRONTEND_URL=https://amulet.am
# BACKEND_URL=https://server.amulet.am

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_API_SECRET=

# Development:
TELEGRAM_BOT_API_URL=http://127.0.0.1:5000/api/telegram/bot

# Production example:
# TELEGRAM_BOT_API_URL=https://server.amulet.am/api/telegram/bot

# Comma-separated Telegram admin chat IDs
TELEGRAM_ADMIN_CHAT_IDS=