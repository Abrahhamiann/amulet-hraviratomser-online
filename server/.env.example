# ---------- Core ----------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/e_invite
JWT_SECRET=change_this_secret_min_32_chars_long_value

# ---------- URLs (единственное место, где меняются адреса) ----------
# dev:  http://localhost:5173 / http://localhost:8080 / http://localhost:5000
# prod: https://amulet.am / https://admin.amulet.am / https://server.amulet.am
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:8080
SERVER_URL=http://localhost:5000
# Доп. origin-ы через запятую (например https://www.amulet.am)
CORS_EXTRA_ORIGINS=

# ---------- Auth cookie ----------
AUTH_COOKIE_NAME=amulet_auth
AUTH_COOKIE_MAX_AGE_MS=604800000
# В проде: .amulet.am — тогда кука общая для amulet.am / admin.amulet.am / server.amulet.am
AUTH_COOKIE_DOMAIN=

# ---------- Google ----------
GOOGLE_CLIENT_ID=954385897484-mvsr9ocebf559dl1b9v7rfvvu4unfqbr.apps.googleusercontent.com

# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=amuletarmenia@gmail.com
SMTP_PASS=your_email_app_password
SMTP_TIMEOUT_MS=20000
AMULET_EMAIL_FROM="Amulet <amuletarmenia@gmail.com>"

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_your_secret_key

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_BOT_USERNAME=your_amulet_bot
TELEGRAM_BOT_API_SECRET=replace_with_a_long_random_secret
TELEGRAM_BOT_API_URL=http://127.0.0.1:5000/api/telegram/bot
TELEGRAM_ADMIN_CHAT_IDS=111111111,222222222
