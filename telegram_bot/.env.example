TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_BOT_USERNAME=your_amulet_bot
# dev:  http://127.0.0.1:5000/api/telegram/bot
# prod: https://server.amulet.am/api/telegram/bot  (или http://127.0.0.1:5000/... если бот на том же сервере)
TELEGRAM_BOT_API_URL=http://127.0.0.1:5000/api/telegram/bot
TELEGRAM_BOT_API_SECRET=replace_with_the_same_long_random_secret_as_the_server
# dev: http://localhost:5173   prod: https://amulet.am
AMULET_SITE_URL=http://localhost:5173
# Comma-separated Telegram chat IDs allowed to receive alerts and use /admin.
TELEGRAM_ADMIN_CHAT_IDS=111111111,222222222
