# ---------- URLs (единственное место, где меняются адреса) ----------
# dev:  http://127.0.0.1:5000/api      prod: https://server.amulet.am/api
VITE_API_URL=http://127.0.0.1:5000/api
# Optional local Vite overrides. Production builds use VITE_API_URL above.
VITE_DEV_API_URL=http://localhost:5000/api
# dev:  http://localhost:5173          prod: https://amulet.am
VITE_CLIENT_URL=http://localhost:5173
VITE_DEV_CLIENT_URL=http://localhost:5173

# Порт SSR-сервера админки при запуске собранного билда (prod: 3000)
PORT=3000
